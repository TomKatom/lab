# Managed by Ansible (roles/wireguard) — do not edit by hand.
[Interface]
{# `address_v6` (interface) and `address_v6` (peer, below) are optional: an
   instance that declares neither renders exactly the single-address line it
   rendered before dual-stack support existed, byte for byte, which is what
   keeps the live management tunnel from restarting on this change. `select`
   with no test keeps only truthy items, so the empty default drops out.
   Two keys rather than one comma-joined `address` so the role's assert can
   check each half's prefix length and subnet on its own. #}
Address = {{ [item.address, item.address_v6 | default('')] | select | join(', ') }}
ListenPort = {{ item.listen_port }}
PrivateKey = {{ wireguard_private_keys[item.name] }}
# Table = off: see roles/wireguard/tasks/main.yml's "Render wg0.conf" task.
Table = off
{% for peer in item.peers %}

[Peer]
{# This bare comment is no longer decoration: roles/wireguard_exporter parses
   it back out to put a readable name on that peer's metrics, so its shape is
   an interface between two roles and tasks/main.yml asserts every peer name
   can survive the round trip.

   REJECTED: `# friendly_name = {{ peer.name }}`, the key=value form
   MindFlavor/prometheus_wireguard_exporter's config parser reads (it splits
   a comment on the first `=` and discards one without any). That would make
   these configs drop-in compatible with an exporter that
   roles/wireguard_exporter/defaults/main.yml demonstrates cannot be
   installed here at all — and it would cost wg0.conf's byte-identity, which
   is what keeps the next converge from restarting the sole management tunnel
   on a host with no console and restrict_management already true. A real
   restart of the only way in, to be compatible with something unobtainable.
   If that exporter ever becomes installable, the reformat is one line here
   plus one `case` arm in the collector, done deliberately and not while
   also changing something else. #}
# {{ peer.name }}
PublicKey = {{ peer.public_key }}
{% if peer.name in (wireguard_peer_psks | default({})) %}
PresharedKey = {{ wireguard_peer_psks[peer.name] }}
{% endif %}
AllowedIPs = {{ [peer.address, peer.address_v6 | default('')] | select | join(', ') }}
{% if peer.persistent_keepalive is defined %}
PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif %}
{% endfor %}
