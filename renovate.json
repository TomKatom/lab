{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "helm-values": {
    "enabled": true
  },
  "kubernetes": {
    "enabled": true,
    "managerFilePatterns": [
      "/clusters/lab/.*\\.ya?ml$/"
    ]
  },
  "argocd": {
    "enabled": true,
    "managerFilePatterns": [
      "/clusters/lab/.*\\.ya?ml$/"
    ]
  },
  "terraform": {
    "enabled": true
  },
  "ansible": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDatasources": ["helm"],
      "groupName": "helm charts"
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "container images"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/roles/[^/]+/defaults/main\\.ya?ml$/",
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^\\.github/actions/[^/]+/action\\.ya?ml$/",
        "/^clusters/lab/apps/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s+\\w+\\s*[:=]\\s*[\"']?(?<currentValue>[^\"'\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}",
      "registryUrlTemplate": "{{{registryUrl}}}"
    }
  ]
}
